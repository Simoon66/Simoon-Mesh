# VITE_SIGNALING_URL: Optional external WebRTC signaling server URL (e.g., https://signal.yourdomain.com).
# If left blank, the application uses local origin /api/signal when running full-stack,
# or operates in 100% serverless Airgap/QR mode on static hosts like Cloudflare Pages.
VITE_SIGNALING_URL=

